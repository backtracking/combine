### sets of tiles ###########################################################

tiles3 pieces =
[ P1 ~one ~rot, P2 ~one ~rot, P3 ~one ~rot,
  P4 ~one ~rot, P5 ~one ~rot, P6 ~one ]

### problem ##############################################################

debug on
timing on

pattern3 one_cube = [{
***
